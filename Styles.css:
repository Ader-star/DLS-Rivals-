* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #0a0a0a;
  color: #ffffff;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

/* HEADER */

.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 6%;
  background: rgba(10, 10, 10, 0.95);
  border-bottom: 1px solid #252525;
}

.logo {
  font-size: 1.2rem;
  font-weight: 900;
  letter-spacing: 1px;
}

#navigation {
  display: flex;
  gap: 24px;
}

#navigation a {
  color: #bbbbbb;
  font-size: 0.9rem;
  font-weight: 600;
}

#navigation a:hover {
  color: #ffffff;
}

.menu-button {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 1.6rem;
}

/* HERO */

.hero {
  min-height: 90vh;
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 50px;
  align-items: center;
  padding: 80px 7%;
  background:
    radial-gradient(circle at 80% 30%, #202020 0, transparent 35%),
    #080808;
}

.eyebrow {
  color: #888;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 3px;
  margin-bottom: 18px;
}

.hero h1 {
  font-size: clamp(3rem, 8vw, 7rem);
  line-height: 0.9;
  font-weight: 900;
  letter-spacing: -4px;
}

.hero h1 span {
  color: #ffffff;
}

.hero-description {
  margin-top: 30px;
  max-width: 500px;
  color: #aaa;
  font-size: 1.1rem;
}

.hero-buttons {
  display: flex;
  gap: 15px;
  margin-top: 35px;
  flex-wrap: wrap;
}

.button {
  display: inline-block;
  padding: 13px 22px;
  border-radius: 6px;
  font-weight: 800;
  border: 1px solid #444;
}

.button.primary {
  background: #ffffff;
  color: #000000;
  border-color: #ffffff;
}

.button.secondary {
  background: transparent;
  color: #ffffff;
}

/* HERO PANEL */

.hero-panel {
  padding: 40px;
  min-height: 280px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 1px solid #303030;
  background: #111111;
  border-radius: 14px;
}

.hero-panel h2 {
  font-size: 2.2rem;
  margin: 20px 0 10px;
}

.hero-panel p {
  color: #999;
}

.online {
  font-size: 0.75rem;
  color: #aaa;
  letter-spacing: 1px;
}

/* SECTIONS */

.section {
  padding: 100px 7%;
  background: #0b0b0b;
}

.section.dark {
  background: #111111;
}

.section h2 {
  font-size: clamp(2.2rem, 5vw, 4rem);
  margin-bottom: 40px;
  letter-spacing: -2px;
}

.empty {
  color: #777;
}

/* CARDS */

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.competition-card {
  min-height: 240px;
  padding: 30px;
  border: 1px solid #303030;
  border-radius: 14px;
  background: #111111;
  transition: transform 0.2s, border-color 0.2s;
}

.competition-card:hover {
  transform: translateY(-5px);
  border-color: #777;
}

